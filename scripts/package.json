{
  "name": "qz-tray-installer",
  "version": "1.0.0",
  "description": "Standalone QZ Tray installer for ProString",
  "main": "installer.js",
  "bin": {
    "qz-tray-installer": "./installer.js"
  },
  "scripts": {
    "build": "npm run build:win && npm run build:sh",
    "build:win": "pkg installer.js --targets node16-win-x64 -o dist/install-qz-tray-win.exe --assets qz-tray-setup.ps1",
    "build:sh": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const os of ['macos','linux'])fs.copyFileSync('qz-tray-setup.sh','dist/install-qz-tray-'+os)\""
  },
  "devDependencies": {
    "pkg": "^5.6.0"
  },
  "pkg": {
    "assets": [
      "qz-tray-setup.ps1"
    ]
  }
}
